# Приклад налаштувань keycrm-mcp. Скопіюйте у .env і заповніть.
# .env не потрапляє в git; не публікуйте реальні ключі.

# Ключ API keyCRM (Налаштування → Загальні → API). Дає повний доступ до CRM.
KEYCRM_API_KEY=

# Toolsets через кому або all (за замовчуванням).
# KEYCRM_TOOLSETS=orders,buyers,catalog,stock,receipts
KEYCRM_TOOLSETS=all

# true — реєструються лише інструменти читання.
KEYCRM_READ_ONLY=false

# Ліміт запитів до API на хвилину (ліміт keyCRM — 20 на ключ).
KEYCRM_RATE_LIMIT=20

# Рівень логів у stderr: debug, info, warn, error.
KEYCRM_LOG_LEVEL=info

# Тека, з якої дозволено завантажувати локальні файли. Порожньо — локальні файли вимкнено.
KEYCRM_UPLOAD_DIR=

# Лише для локальних тестів: дозволити завантаження з приватних адрес.
KEYCRM_ALLOW_PRIVATE_URLS=false

# Bearer-токен для транспорту Streamable HTTP (--http). Без нього HTTP-режим не стартує.
KEYCRM_MCP_HTTP_TOKEN=

# Лише для інтеграційних тестів (-tags integration, тільки читання).
KEYCRM_TEST_API_KEY=
